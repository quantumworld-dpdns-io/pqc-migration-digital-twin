worker_processes auto;
pid /var/run/nginx.pid;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 1024;
}

http {
    include      /etc/nginx/mime.types;
    default_type application/octet-stream;

    client_body_temp_path /var/cache/nginx/client_temp;
    proxy_temp_path       /var/cache/nginx/proxy_temp;
    fastcgi_temp_path     /var/cache/nginx/fastcgi_temp;
    uwsgi_temp_path       /var/cache/nginx/uwsgi_temp;
    scgi_temp_path        /var/cache/nginx/scgi_temp;

    access_log /var/log/nginx/access.log;
    sendfile   on;
    keepalive_timeout 65;
    server_tokens off;

    # ── Security headers (all responses) ─────────────────────────────────────
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options           "DENY" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-XSS-Protection          "0" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=()" always;

    # ── CORS — allow localhost and Choreo origins ─────────────────────────────
    map $http_origin $cors_origin {
        default                                  "";
        "~^https?://localhost(:\d+)?$"           $http_origin;
        "~^https://[a-z0-9-]+\.choreoapis\.dev$" $http_origin;
        "~^https://pqc-digital-twin\.dennisleehappy\.org(:\d+)?$" $http_origin;
        "${CORS_ALLOW_ORIGIN}"                   $http_origin;
    }

    # ── Upstream ──────────────────────────────────────────────────────────────
    upstream go_services {
        server ${GO_SERVICES_HOST};
    }

    # Select the server block for this environment.
    # Allowed values: local | choreo
    include /tmp/nginx-runtime/server.conf;
}
