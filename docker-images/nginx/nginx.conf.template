worker_processes auto;
# Choreo runs the container with a read-only root filesystem, so every path
# nginx writes to must live under the writable /tmp/nginx-runtime (or go to
# stdout/stderr). Writing the pid to /var/run fails with "Read-only file system".
pid /tmp/nginx-runtime/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include      /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Temp paths under the writable runtime dir (read-only root filesystem).
    client_body_temp_path /tmp/nginx-runtime/client_temp;
    proxy_temp_path       /tmp/nginx-runtime/proxy_temp;
    fastcgi_temp_path     /tmp/nginx-runtime/fastcgi_temp;
    uwsgi_temp_path       /tmp/nginx-runtime/uwsgi_temp;
    scgi_temp_path        /tmp/nginx-runtime/scgi_temp;

    access_log /dev/stdout;
    sendfile   on;
    keepalive_timeout 65;
    server_tokens off;

    # ── Security headers (all responses) ─────────────────────────────────────
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options           "DENY" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-XSS-Protection          "0" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=()" always;

    # ── CORS — allow localhost and Choreo origins ─────────────────────────────
    map $http_origin $cors_origin {
        default                                  "";
        "~^https?://localhost(:\d+)?$"           $http_origin;
        "~^https://[a-z0-9-]+\.choreoapis\.dev$" $http_origin;
        "~^https://pqc-digital-twin\.dennisleehappy\.org(:\d+)?$" $http_origin;
        "${CORS_ALLOW_ORIGIN}"                   $http_origin;
    }

    # ── Backend resolution ────────────────────────────────────────────────────
    # Resolve the Go backend lazily at request time (NOT at startup) so nginx
    # boots and stays Ready even when go-services is not yet deployed/connected.
    # An "upstream {}" block or a literal hostname in proxy_pass would force
    # resolution during "nginx -t" and crash-loop the pod when the backend DNS
    # name does not exist yet.
    resolver ${RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    map $host $go_backend {
        default "${GO_SERVICES_HOST}";
    }

    # Select the server block for this environment.
    # Allowed values: local | choreo
    include /tmp/nginx-runtime/server.conf;
}
