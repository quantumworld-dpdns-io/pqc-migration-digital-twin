{
  "openapi": "3.0.3",
  "info": {
    "title": "PQC Migration Gateway API",
    "version": "0.1.0",
    "description": "Gateway proxy API for discovery, risk scoring, proof generation, and QASM examples."
  },
  "servers": [
    { "url": "http://localhost:8080" }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Gateway health",
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "enum": ["ok"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/discovery": {
      "post": {
        "summary": "Run discovery scan",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "address": { "type": "string" },
                  "port": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Discovery response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["target", "findings"],
                  "properties": {
                    "target": { "type": "object" },
                    "findings": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/risk": {
      "post": {
        "summary": "Compute HNDL risk score",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "total_assets": { "type": "number", "minimum": 0 },
                  "quantum_vulnerable_assets": { "type": "number", "minimum": 0 },
                  "policy": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Risk score response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["policy", "exposure_ratio", "score"],
                  "properties": {
                    "policy": { "type": "string" },
                    "exposure_ratio": { "type": "number" },
                    "score": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/proof": {
      "post": {
        "summary": "Generate proof payload",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "statement": { "type": "string" },
                  "credit_score": { "type": "integer" },
                  "debt_to_income_bps": { "type": "integer" },
                  "late_payments": { "type": "integer" },
                  "existing_loans": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Proof response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["statement", "score_value", "score_band", "proof_hash"],
                  "properties": {
                    "statement": { "type": "string" },
                    "score_value": { "type": "integer" },
                    "score_band": { "type": "string" },
                    "proof_hash": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/qasm": {
      "post": {
        "summary": "List or fetch QASM examples",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "QASM examples response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
