{
  "openapi": "3.0.3",
  "info": {
    "title": "PQC Migration Gateway API",
    "version": "0.1.0",
    "description": "Gateway proxy API for discovery, risk scoring, proof generation, and QASM examples."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Gateway health",
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/discovery": {
      "post": {
        "summary": "Run discovery scan",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Discovery response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "target",
                    "findings"
                  ],
                  "properties": {
                    "target": {
                      "type": "object"
                    },
                    "findings": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/risk": {
      "post": {
        "summary": "Compute HNDL risk score",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "total_assets": {
                    "type": "number",
                    "minimum": 0
                  },
                  "quantum_vulnerable_assets": {
                    "type": "number",
                    "minimum": 0
                  },
                  "policy": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Risk score response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "policy",
                    "exposure_ratio",
                    "score"
                  ],
                  "properties": {
                    "policy": {
                      "type": "string"
                    },
                    "exposure_ratio": {
                      "type": "number"
                    },
                    "score": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/proof": {
      "post": {
        "summary": "Generate proof payload",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string"
                  },
                  "credit_score": {
                    "type": "integer"
                  },
                  "debt_to_income_bps": {
                    "type": "integer"
                  },
                  "late_payments": {
                    "type": "integer"
                  },
                  "existing_loans": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Proof response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "statement",
                    "score_value",
                    "score_band",
                    "proof_hash"
                  ],
                  "properties": {
                    "statement": {
                      "type": "string"
                    },
                    "score_value": {
                      "type": "integer"
                    },
                    "score_band": {
                      "type": "string"
                    },
                    "proof_hash": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/qasm": {
      "post": {
        "summary": "List or fetch QASM examples",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "QASM examples response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assets": {
      "get": {
        "summary": "List deduplicated discovered assets",
        "responses": {
          "200": {
            "description": "Asset list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "count",
                    "assets"
                  ],
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "assets": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/risk/backlog": {
      "post": {
        "summary": "Export ranked migration backlog",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "policy": {
                    "type": "string"
                  },
                  "asset_rows": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked backlog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "policy",
                    "backlog"
                  ],
                  "properties": {
                    "policy": {
                      "type": "string"
                    },
                    "backlog": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/governance/exceptions": {
      "get": {
        "summary": "List governance exceptions",
        "responses": {
          "200": {
            "description": "Exception list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "exceptions"
                  ],
                  "properties": {
                    "exceptions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GovernanceException"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create governance exception",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GovernanceExceptionCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created exception record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GovernanceException"
                }
              }
            }
          },
          "400": {
            "description": "Missing required fields"
          }
        }
      }
    },
    "/api/v1/governance/verifier-drift": {
      "get": {
        "summary": "Get verifier drift summary",
        "responses": {
          "200": {
            "description": "Verifier drift status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "current_verifier_version",
                    "latest_verifier_version",
                    "drift"
                  ],
                  "properties": {
                    "current_verifier_version": {
                      "type": "string"
                    },
                    "latest_verifier_version": {
                      "type": "string"
                    },
                    "drift": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit/events": {
      "get": {
        "summary": "List gateway audit events",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Optional cap for most recent events."
          }
        ],
        "responses": {
          "200": {
            "description": "Audit events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "events"
                  ],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "timestamp",
                          "route",
                          "method",
                          "outcome"
                        ],
                        "properties": {
                          "timestamp": {
                            "type": "string"
                          },
                          "route": {
                            "type": "string"
                          },
                          "method": {
                            "type": "string"
                          },
                          "outcome": {
                            "type": "string",
                            "enum": [
                              "success",
                              "error"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid limit parameter"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GovernanceExceptionCreateRequest": {
        "type": "object",
        "required": [
          "asset_id",
          "reason",
          "owner"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          }
        }
      },
      "GovernanceException": {
        "type": "object",
        "required": [
          "exception_id",
          "asset_id",
          "reason",
          "owner",
          "status",
          "created_at"
        ],
        "properties": {
          "exception_id": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open"
            ]
          },
          "created_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
