# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is git-ignored — never commit real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── AlwaysData PostgreSQL (Choreo / production) ────────────────────────────
# Host:     postgresql-dennislee928.alwaysdata.net
# Port:     5432
# User:     dennislee928
# Database: dennislee928_postgres
# Admin UI: https://phppgadmin.alwaysdata.com/phppgadmin/index.php
DATABASE_URL=postgres://dennislee928:<YOUR_PASSWORD>@postgresql-dennislee928.alwaysdata.net:5432/dennislee928_postgres?sslmode=require

# ── Local dev override (docker-compose.microservices.yml) ──────────────────
# Uncomment to point services at the local postgres container instead.
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/pqc_digital_twin?sslmode=disable

# ── Choreo compose image registry ─────────────────────────────────────────
# Used by docker-compose.microservices-chore-dev.yml
REGISTRY=ghcr.io/your-org
TAG=latest

# ── nginx proxy config ────────────────────────────────────────────────────
GO_SERVICES_HOST=go-services:8080
# Optional extra origin (nginx also allows localhost, *.choreoapis.dev, Vercel FE via map).
CORS_ALLOW_ORIGIN=http://localhost:3000

# ── Next.js frontend ──────────────────────────────────────────────────────
# NEXT_PUBLIC_GATEWAY_URL is visible in the browser bundle. Point it at the
# consolidated Choreo `backend` component (includes the /v1.0 suffix; the client
# appends /api/v1/...). Use the prod URL for production, the dev URL for preview.
NEXT_PUBLIC_GATEWAY_URL=https://localhost
# Production: https://baedb35c-04cc-4166-887d-a16b2b56924b-prod.e1-eu-north-azure.choreoapis.dev/pqc-migration-digital-twi/backend/v1.0
# Development: https://baedb35c-04cc-4166-887d-a16b2b56924b-dev.e1-eu-north-azure.choreoapis.dev/pqc-migration-digital-twi/backend/v1.0

# ── API Authentication (Choreo) ───────────────────────────────────────────
# The Choreo managed API authenticates via the `Api-Key` header (Bearer is
# rejected). Set the token below ONLY if the endpoint keeps security enabled —
# use a long-lived application API key from a Choreo subscription, NOT the
# `choreo create test-key` value (that expires in 600s). If you disable endpoint
# security in Choreo, leave these empty and no auth header is sent.
# GATEWAY_TOKEN is server-side (SSR); NEXT_PUBLIC_GATEWAY_TOKEN is browser-side.
GATEWAY_TOKEN=
NEXT_PUBLIC_GATEWAY_TOKEN=

# GATEWAY_URL is server-only (used by Next.js API rewrites in dev). In Vercel set
# it to the same Choreo backend URL as NEXT_PUBLIC_GATEWAY_URL.
GATEWAY_URL=http://localhost:8080
